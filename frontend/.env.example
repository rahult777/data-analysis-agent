# Base URL of the backend API; lib/mode.ts falls back to http://localhost:8000 when it is unset.
# Copy this file to .env.local. Next.js inlines NEXT_PUBLIC_* values at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Never set NEXT_PUBLIC_DATA_SOURCE in this or any other .env file. Next.js loads .env files
# before next.config.mjs, so a value here would switch every build and `next dev`.
# `npm run build:public` sets it inline for the public snapshot build, and a value set in
# the process wins over the files.
