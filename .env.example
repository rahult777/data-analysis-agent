ANTHROPIC_API_KEY=
SUPABASE_URL=
# Not used by the backend or frontend; only the .live/ verification harness reads it.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Only when LANGCHAIN_TRACING_V2=true.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# "true" (case-insensitive) turns LangSmith tracing on; agents run only then. Any other value, or unset:
# the backend runs read-only and refuses every request that would start or continue agent work (503).
LANGCHAIN_TRACING_V2=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Not read by the app; only the GitHub MCP server uses it.
GITHUB_TOKEN=
