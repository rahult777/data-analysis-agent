# Required only when agent work is on (AGENT_WORK_ENABLED=true).
ANTHROPIC_API_KEY=
SUPABASE_URL=
# Not used by the backend or frontend; only the .live/ verification harness reads it.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Only when LANGCHAIN_TRACING_V2=true.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# "true" (case-insensitive) turns LangSmith tracing on. Agent work also needs AGENT_WORK_ENABLED; without both, the backend runs read-only (503).
LANGCHAIN_TRACING_V2=
# Required only when agent work is on (AGENT_WORK_ENABLED=true).
ANTHROPIC_MODEL=claude-sonnet-4-6
# Agent work (paid model calls) is off unless this is "true". Do not set it here: the boot fails if .env sets it.
# Turn it on per session, e.g. AGENT_WORK_ENABLED=true python -m uvicorn backend.main:app ...
# Browser origins allowed to call the API: exact origins, comma-separated; "*" is refused.
# Default when unset: http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Not read by the app; only the GitHub MCP server uses it.
GITHUB_TOKEN=
